{
  "info": {
    "_postman_id": "pennypilot-v1-collection",
    "name": "PennyPilot V1",
    "description": "PennyPilot V1 — Core Expense Tracker API. Full CRUD + filtering + summary endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{baseUrl}}"
    }
  ],
  "item": [
    {
      "name": "Expenses",
      "item": [
        {
          "name": "1. Create Expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response has id', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.environment.set('expenseId', json.id);",
                  "});",
                  "pm.test('Category matches', function () {",
                  "    pm.expect(pm.response.json().category).to.eql('FOOD');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Grocery Shopping\",\n  \"amount\": 1250.50,\n  \"category\": \"FOOD\",\n  \"expenseDate\": \"2026-08-20\",\n  \"description\": \"Weekly groceries\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/expenses", "host": ["{{baseUrl}}"], "path": ["api", "v1", "expenses"] }
          }
        },
        {
          "name": "2. Create Expense — Validation Error (empty title)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('fieldErrors is present', function () {",
                  "    pm.expect(pm.response.json().fieldErrors).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"amount\": 1250.50,\n  \"category\": \"FOOD\",\n  \"expenseDate\": \"2026-08-20\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/expenses", "host": ["{{baseUrl}}"], "path": ["api", "v1", "expenses"] }
          }
        },
