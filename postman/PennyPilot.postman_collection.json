            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/expenses", "host": ["{{baseUrl}}"], "path": ["api", "v1", "expenses"] }
          }
        },
        {
          "name": "6. List Expenses — Filter by Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All results are FOOD category', function () {",
                  "    pm.response.json().forEach(function(e) {",
                  "        pm.expect(e.category).to.eql('FOOD');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses?category=FOOD",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses"],
              "query": [{ "key": "category", "value": "FOOD" }]
            }
          }
        },
